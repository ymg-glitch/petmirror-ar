<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <Space
        android:id="@+id/panelBounds"
        android:layout_width="220dp"
        android:layout_height="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:minWidth="80dp"
        android:text="猫犬魔镜"
        android:textColor="@color/pet_green"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvConnection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvConnection"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:background="@drawable/bg_chip"
        android:gravity="center"
        android:minWidth="64dp"
        android:text="离线演示"
        android:textColor="@color/pet_green_dim"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/panelBounds"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/cardStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/cardAdvice"
        app:layout_constraintEnd_toEndOf="@id/panelBounds"
        app:layout_constraintHeight_percent="0.28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPetType"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:minWidth="30dp"
                android:text="猫"
                android:textColor="@color/pet_white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRisk"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_chip_alert"
                android:gravity="center"
                android:minWidth="46dp"
                android:text="需关注"
                android:textColor="@color/pet_yellow"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/3"
                android:textColor="@color/pet_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmotion"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="3dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="紧张"
            android:textColor="@color/pet_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
            android:id="@+id/tvNeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:text="需要安抚"
                android:textColor="@color/pet_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="82%"
                android:textColor="@color/pet_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardAdvice"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_panel_strong"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/tvHint"
        app:layout_constraintEnd_toEndOf="@id/panelBounds"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardStatus">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="建议动作"
            android:textColor="@color/pet_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvAdvice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:text="降低声音，保持距离，等待它主动靠近。"
            android:textColor="@color/pet_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReason"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:text="耳朵后压、尾巴贴近身体，可能处于防御状态。"
            android:textColor="@color/pet_green_dim"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="单击查看建议  ·  前后滑切换  ·  双击退出"
        android:textColor="@color/pet_muted"
        android:textSize="9sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/panelBounds"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
